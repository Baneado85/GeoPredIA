COLUMN TABLE "GEOPREDIA_EVALUATIONS" (
    "EVALUATION_ID" NVARCHAR(36) NOT NULL,
    "ZONE_ID" NVARCHAR(36) NOT NULL,
    "SCENARIO_NAME" NVARCHAR(50) DEFAULT 'BASE',
    "MODEL_VERSION" NVARCHAR(20) DEFAULT 'v1.0.0',
    "GEO_SCORE" DECIMAL(5, 2) NOT NULL,
    "ENV_SCORE" DECIMAL(5, 2) NOT NULL,
    "SOC_SCORE" DECIMAL(5, 2) NOT NULL,
    "GLOBAL_RISK_SCORE" DECIMAL(5, 2) NOT NULL,
    "STATUS" NVARCHAR(30) DEFAULT 'PENDING_REVIEW',
    "REVIEWER_NOTES" NCLOB,
    "EVALUATED_AT" TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY ("EVALUATION_ID")
);
