COLUMN TABLE "GEOPREDIA_IOT_READINGS" (
    "READING_ID" NVARCHAR(36) NOT NULL,
    "DEVICE_ID" NVARCHAR(50) NOT NULL,
    "ZONE_ID" NVARCHAR(36) NOT NULL,
    "SENSOR_TYPE" NVARCHAR(50) NOT NULL,
    "VALUE" DECIMAL(10, 4) NOT NULL,
    "UNIT" NVARCHAR(20) NOT NULL,
    "IS_SIMULATED" BOOLEAN DEFAULT FALSE,
    "READING_AT" TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY ("READING_ID")
);
