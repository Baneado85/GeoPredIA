# Local prototype; never commit .env or real keys.
SEED_DEMO=true
# GEOPREDIA_DB=.local/geopredia.db
# The desktop frontend is local. Remote API clients must send X-API-Key.
APP_API_KEY=
# Comma-separated additional server hostnames, only for an intentional deployment.
GEOPREDIA_ALLOWED_HOSTS=
# Device/simulator requests must send this value as X-Device-Key.
DEVICE_API_KEY=

# Optional paid/limited LLM service. Disabled until explicitly enabled.
LLM_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SAP configuration from the event's service keys. Never enter credentials in browser code.
HANA_ADDRESS=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_ZONE_VIEW=
HANA_TEAM_SCHEMA=
# Example HANA_ZONE_VIEW=GEOPREDIA_TEAM.ZONE_MAPPING
BPA_API_URL=
BPA_TOKEN_URL=
BPA_CLIENT_ID=
BPA_CLIENT_SECRET=
BPA_DEFINITION_ID=
BPA_CALLBACK_KEY=
